# LLM provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# GitHub: either a token, or GitHub App credentials (preferred)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Supabase (optional: falls back to the in-memory store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Root directory containing local checkouts of target repositories.
# Each repository is expected at <root>/<owner>__<name>.
AI_DEV_TEAM_WORKSPACES=.workspaces
